{
  "additionalProperties": false,
  "description": "A single Quranic verse — the leaf of the tree.",
  "properties": {
    "key": {
      "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$",
      "title": "Key",
      "type": "string"
    },
    "id": {
      "pattern": "^ayah:[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$",
      "title": "Id",
      "type": "string"
    },
    "global_id": {
      "maximum": 6236,
      "minimum": 1,
      "title": "Global Id",
      "type": "integer"
    },
    "sura": {
      "maximum": 114,
      "minimum": 1,
      "title": "Sura",
      "type": "integer"
    },
    "aya": {
      "minimum": 1,
      "title": "Aya",
      "type": "integer"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "text_raw": {
      "title": "Text Raw",
      "type": "string"
    },
    "text_clean": {
      "title": "Text Clean",
      "type": "string"
    },
    "char_count": {
      "minimum": 0,
      "title": "Char Count",
      "type": "integer"
    },
    "word_count": {
      "minimum": 0,
      "title": "Word Count",
      "type": "integer"
    },
    "sajda": {
      "anyOf": [
        {
          "enum": [
            "obligatory",
            "recommended"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sajda"
    },
    "page": {
      "maximum": 604,
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "parents": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Parents",
      "type": "object"
    }
  },
  "required": [
    "key",
    "id",
    "global_id",
    "sura",
    "aya",
    "text",
    "text_raw",
    "text_clean",
    "char_count",
    "word_count",
    "sajda",
    "page",
    "parents"
  ],
  "title": "ayah",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quran-etl.local/schemas/ayah.schema.json",
  "$comment": "quran-etl wire schema version 4"
}